# Copier ce fichier en .env (cp .env.example .env) puis remplacer les valeurs.
# Le fichier .env ne doit JAMAIS être publié sur GitHub.

# Base de données PostgreSQL
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=changeme

# Clé secrète utilisée pour signer les jetons de connexion (mettre une longue valeur aléatoire)
SECRET_KEY=changeme-cle-secrete

# Port du frontend sur la machine (http://localhost:8080 par défaut)
FRONTEND_PORT=8080
